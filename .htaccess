# Thank You America - valves section (/valves/)
# Clean URLs: /valves/about-us is served by about-us.php
Options -MultiViews -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteBase /valves/

# ---- Security ----
# Always use HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Only normal browser requests
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
RewriteRule ^ - [F]
# Hidden files and folders (.git, .env, .htaccess ...)
RewriteRule (^|/)\. - [F]
# Setup notes, logs, lead data, backups and the SMTP sample are never public
<FilesMatch "(?i)\.(md|txt|log|csv|ini|sh|sql|bak|old|orig|swp|dist|lock|sample\.php)$">
  Require all denied
</FilesMatch>
# Include files are only loaded by the pages, never opened directly
RewriteRule ^(includes|leads)/ - [F]

# Old .html addresses -> new clean addresses (301, keeps any Google ranking)
RewriteRule ^index\.html$ /valves/ [R=301,L]
RewriteRule ^ball-valves\.html$ /valves/ball-valves/ [R=301,L]
RewriteRule ^series-\d+-(.+)\.html$ /valves/ball-valves/$1 [R=301,L]
RewriteRule ^(.+)\.html$ /valves/$1 [R=301,L]

# Someone typing the .php address -> clean address (the form handler is left alone)
RewriteCond %{THE_REQUEST} \s[^?\s]*\.php[\s?]
RewriteCond %{REQUEST_URI} !send-catalog\.php$
RewriteRule ^(.*?)(?:index)?\.php$ /valves/$1 [R=301,L]

# Trailing slash on a page -> without (except real folders like ball-valves/)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /valves/$1 [R=301,L]

# Serve clean URLs from the .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]


# Sitemap: always send as XML so Google Search Console can read it
<Files "sitemap.xml">
  ForceType application/xml
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set X-Robots-Tag "noindex"
  </IfModule>
</Files>

# ---- Security headers on every file (pages also send their own from includes/security.php) ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ---- Speed (helps Google page experience) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
